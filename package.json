{
  "name": "pocket-corner",
  "version": "1.0.0",
  "private": true,
  "description": "Pocket Corner - Desktop Toy social multiplayer em pixel art (Web Document PiP + Tauri v2 + Socket.io)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"tsx watch server/index.ts\" \"vite --host\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host",
    "desktop": "electron electron/main.cjs",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "express": "^4.21.2",
    "mongodb": "^7.7.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2"
  },
  "optionalDependencies": {
    "electron": "^45.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
