# ==========================================================
# POCKET CORNER - VARIÁVEIS DE AMBIENTE (.env)
# ==========================================================

# 1. GOOGLE OAUTH 2.0 (Cole aqui o "ID do cliente" do Google Auth Platform)
# Exemplo: 614958022711-xxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# 2. MONGODB ATLAS (Cole aqui sua string de conexão do MongoDB Atlas)
# Se estiver vazio, o servidor salva localmente em server/data/db.json
# Exemplo: mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/pocket_corner?retryWrites=true&w=majority
MONGODB_URI=

# 3. MERCADO PAGO (Para vendas reais via PIX de Pip Diamantes e Double D Pack)
# Cole aqui o seu Access Token de Produção (APP_USR-...) do Mercado Pago Developers
MERCADOPAGO_ACCESS_TOKEN=
# Opcional: URL pública do seu servidor no Render para receber confirmação automática via Webhook
# Exemplo: https://seu-app.onrender.com
PUBLIC_BASE_URL=

# 4. PAINEL DO ADMINISTRADOR (Validado 100% no Backend)
# Digite o e-mail do Gmail que terá permissão de Administrador para ver todas as transações e compras
ADMIN_EMAIL=
# Segredo usado pelo servidor para assinar tokens de sessão (se vazio, o servidor gera/usa um padrão seguro)
SESSION_SECRET=

