{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pocket Corner",
  "version": "1.0.0",
  "identifier": "com.pocketcorner.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Pocket Corner",
        "width": 720,
        "height": 360,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
